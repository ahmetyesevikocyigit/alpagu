[Unit]
Description=Alpagu Dernegi Next.js site and CMS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alpagu
Group=alpagu
WorkingDirectory=/opt/alpagu/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=PORT=__APP_PORT__
Environment=NEXT_PUBLIC_SITE_URL=https://__SITE_HOST__
Environment=CMS_ORIGIN=https://__SITE_HOST__
Environment=CMS_LOCAL_DIR=/var/lib/alpagu/cms
Environment=SITE_INDEXABLE=__SITE_INDEXABLE__
LoadCredentialEncrypted=cms_password_hash:/etc/credstore.encrypted/alpagu-cms-password.cred
ExecStart=/opt/alpagu/shared/start.sh
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/alpagu /opt/alpagu/current/.next/cache
MemoryHigh=512M
MemoryMax=640M
TasksMax=256

[Install]
WantedBy=multi-user.target
